# Data artifacts live on the volume, never in the image.
raw/
*.db
index/
data/
reports/
notes/
# Environments and tooling.
.venv/
.git/
.github/
.pytest_cache/
__pycache__/
tests/
scripts/
docs/
.env
.env.*
# The web app is built inside the image (node stage); a laptop build must not leak in.
web/node_modules/
web/dist/
# Phase 1: the Workers, the static release and other working folders never go into the engine image.
worker/
site/
build/
eval/*
!eval/seed_questions.jsonl
design-review/
showcase/
*.npy
scopes.r2.sha256

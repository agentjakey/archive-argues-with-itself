# The engine image with the release's data baked in (provisioning option "image",
# docs/v2/DECISIONS.md "Data provisioning"). Built by scripts/v2/build_baked_image.py from the
# serving image and a staging folder that holds only files verified against config/scopes.toml,
# passed as the named build context "data". With CIVIC_PROVISION=present and
# CIVIC_VERIFY_PRESENT=trust-image the container serves these files without hashing them again:
# the registry verifies every layer by its digest when the image is pulled.
ARG BASE_IMAGE=archive-engine:local
FROM ${BASE_IMAGE}
COPY --from=data civic.db /data/civic.db
COPY --from=data index/dense/ /data/index/dense/
COPY --from=data microlog/civic_microlog.db /data/microlog/civic_microlog.db
COPY --from=data microlog/index/dense/ /data/microlog/index/dense/

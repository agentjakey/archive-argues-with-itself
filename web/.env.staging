# Build settings for the staging site (npm run build:staging). Public values only: the staging
# engine Worker and Cloudflare's documented invisible always-pass Turnstile test site key, which
# pairs with the test secret set on staging.
VITE_STATIC_DATA=/data
VITE_API_BASE=https://archive-argues-engine-staging.jakemyguy.workers.dev
VITE_TURNSTILE_SITEKEY=1x00000000000000000000BB

# Build settings for the production site (npm run build:production). Public values only: the
# production engine Worker and the production Turnstile site key (its secret is a wrangler secret on
# the engine). The mode is named "release", not "production", because a plain `vite build` reads
# .env.production, and the engine image's own build must stay out of static mode.
VITE_STATIC_DATA=/data
VITE_API_BASE=https://api.archiveargues.org
VITE_TURNSTILE_SITEKEY=0x4AAAAAAFsWxefCz5Lu5vWr

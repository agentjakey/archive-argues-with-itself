// The engine Worker and its container (docs/SELF_HOSTING.md). Deploy with
//   npx wrangler deploy --env staging      (workers.dev, first)
//   npx wrangler deploy --env production   (api.archiveargues.org, after Gate 1)
// Account-specific values marked SET-ME are filled in by the account owner from the runbook
// (wrangler d1 create, the R2 bucket name); secrets are set with `wrangler secret put` and never
// appear here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archive-argues-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["enable_ctx_exports"],
  "observability": { "enabled": true },

  "env": {
    "staging": {
      "name": "archive-argues-engine-staging",
      "workers_dev": true,
      "preview_urls": false,
      "containers": [
        {
          "name": "archive-engine-staging",
          "class_name": "EngineContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "base": { "dockerfile": "../../Dockerfile", "build_context": "../.." }
          }
        }
      ],
      "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "EngineContainer" }] },
      "exports": { "EngineContainer": { "type": "durable-object", "storage": "sqlite" } },
      "d1_databases": [
        { "binding": "DB", "database_name": "archive-argues-cache-staging", "database_id": "dbc5e356-bb61-4516-950c-d8ac8a04a511", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "DATA", "bucket_name": "archive-argues-data" },
        { "binding": "BENCH_R2", "bucket_name": "archive-argues-bench-staging" }
      ],
      // staging only: the cache-store bench (src/bench.ts); production has no BENCH_* bindings
      "kv_namespaces": [{ "binding": "BENCH_KV", "id": "6eedf42d9da5473db1d68bfea8253c10" }],
      "ratelimits": [
        { "name": "RL_ASK", "namespace_id": "2001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_WAKE", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["*/10 * * * *"] },
      "vars": {
        "RELEASE_ID": "SET-BY-RELEASE",
        "ENGINE_LAYOUT": "split",
        "INSTANCE_TYPE": "standard-3",
        "INSTANCE_TYPES": "{\"pilot\": \"standard-2\", \"microlog\": \"standard-2\"}",
        "SLEEP_AFTER_MINUTES": "15",
        "PROVISION_MODE": "snapshot",
        "SNAPSHOT_VERIFY": "trust",
        "DENSE_BACKEND": "numpy",
        "ALLOWED_ORIGINS": "https://archive-argues-site-staging.jakemyguy.workers.dev,http://localhost:5173",
        "DAILY_MODEL_CALLS": "100",
        "TURNSTILE_REQUIRED": "true",
        "KEEP_WARM_WINDOWS": "",
        "PUBLIC_URL": "https://archive-argues-site-staging.jakemyguy.workers.dev"
      }
    },

    "production": {
      "name": "archive-argues-engine",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.archiveargues.org", "custom_domain": true }],
      "containers": [
        {
          "name": "archive-engine",
          "class_name": "EngineContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "base": { "dockerfile": "../../Dockerfile", "build_context": "../.." }
          }
        }
      ],
      "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "EngineContainer" }] },
      "exports": { "EngineContainer": { "type": "durable-object", "storage": "sqlite" } },
      "d1_databases": [
        { "binding": "DB", "database_name": "archive-argues-cache", "database_id": "SET-ME-production-d1-id", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "archive-argues-data" }],
      "ratelimits": [
        { "name": "RL_ASK", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_WAKE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["*/10 * * * *"] },
      "vars": {
        "RELEASE_ID": "SET-BY-RELEASE",
        "ENGINE_LAYOUT": "split",
        "INSTANCE_TYPE": "standard-3",
        "INSTANCE_TYPES": "{\"pilot\": \"standard-2\", \"microlog\": \"standard-2\"}",
        "SLEEP_AFTER_MINUTES": "15",
        "PROVISION_MODE": "snapshot",
        "SNAPSHOT_VERIFY": "trust",
        "DENSE_BACKEND": "numpy",
        "ALLOWED_ORIGINS": "https://archiveargues.org,https://www.archiveargues.org",
        "DAILY_MODEL_CALLS": "300",
        "TURNSTILE_REQUIRED": "true",
        "KEEP_WARM_WINDOWS": "",
        "PUBLIC_URL": "https://archiveargues.org"
      }
    }
  }
}

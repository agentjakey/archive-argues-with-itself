ANTHROPIC_API_KEY=
# Optional. Comma-separated CORS allow-list for a separately hosted web app; unset = same-origin only.
# ALLOWED_ORIGINS=
# Optional. Data-file locations when they live outside the repo (containers mount /data).
# The database must NOT live in a synced folder (OneDrive, Dropbox, iCloud): the sync
# client holds locks and long write transactions fail with "database is locked".
# CIVIC_DB_PATH=/data/civic.db
# CIVIC_INDEX_PATH=/data/index/vectors.db
# CIVIC_CACHE_PATH=/data/cache/answers.db

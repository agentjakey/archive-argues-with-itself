# Security and caching headers for the static site (Workers static assets, applied to asset
# responses). scripts/v2/build_release.py fills in {api_origin} for the release's engine Worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://archive.org; img-src 'self' data: https://archive.org https://*.archive.org https://*.us.archive.org; connect-src 'self' {api_origin}; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Caching. Vite names every built asset by its content hash, and the data shards sit in a folder
# named by the hash of their content, so both are cached for a year and never revalidated. The HTML
# (which names the current data folder) and the release manifest are always revalidated, so a new
# release is seen on the next visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/release-manifest.json
  Cache-Control: no-cache

# The exhibit (/exhibit/): its built assets and its decks are named by their content and cached for
# a year; its page and the pointer to the current deck are always revalidated.
/exhibit/assets/*
  Cache-Control: public, max-age=31536000, immutable

/exhibit/decks/*
  Cache-Control: public, max-age=31536000, immutable

/exhibit/
  Cache-Control: no-cache

/exhibit/index.html
  Cache-Control: no-cache

/exhibit/current-deck.json
# The catalogue browser (/catalogue/): its compiled files change with each release, so they are
# cached for an hour; the page itself is revalidated.
/catalogue/data/*
  Cache-Control: public, max-age=3600

/catalogue/
  Cache-Control: no-cache
